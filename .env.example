# Server-only Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional server-side admin allowlist overrides. Production owner identities
# live in the RLS-locked store_admins table instead of source or environment.
SUPABASE_ADMIN_EMAILS=owner@example.com
SUPABASE_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000
