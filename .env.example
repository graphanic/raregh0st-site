# Browser-safe Supabase Auth configuration (Vite build-time variables)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Comma-separated Supabase Auth user UUIDs allowed into /admin/*
SUPABASE_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000
